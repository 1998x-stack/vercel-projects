{
  "name": "vercel-projects-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Auditable Vercel portfolio directory and static GitHub Pages frontend",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/validate.mjs && node scripts/check-contrast.mjs",
    "a11y": "node scripts/check-contrast.mjs",
    "ui:check": "node scripts/ui-check.mjs",
    "clone:repos": "node scripts/clone-repos.mjs",
    "clone:repos:bg": "bash scripts/clone-repos.sh",
    "atlas:tick": "bash scripts/atlas-dashboard/tick.sh",
    "atlas:status": "bash scripts/atlas-dashboard/status.sh",
    "atlas:install": "bash scripts/atlas-dashboard/install-scheduler.sh install",
    "build": "node scripts/validate.mjs && node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT"
}
